---
layout: none
---
[
  {% for post in site.posts %}
    {
      "title"    : {{ post.title | jsonify }},
      {%- assign first_post_category = post.categories.first -%}
      {%- assign category_url = '' -%}
      {%- assign category_title = first_post_category -%}
      {%- for category in site.data.categories -%}
        {%- if first_post_category == category.title -%}
          {%- assign category_url = category.url -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      "category_url" : {{ category_url | jsonify }},
      "category_title": {{ category_title | jsonify }},
      "tags"     : {{ post.tags | join: ', ' | jsonify }},
      "url"      : {{ post.url | jsonify }},
      "date"     : {{ post.date | date: '%B %d, %Y' | jsonify }},
      "author_id"   : {{ post.author | jsonify }},
      {%- assign author_data = site.data.authors.authors[post.author] -%}
      "author_name" : {{ author_data.name | jsonify }},
      "author_picture" : {{ author_data.picture | default: "avatar.png" | jsonify }},
      {%- assign allContributors = post.contributors | join: '|' | prepend: '|' | prepend: post.author | split: '|' -%}
      "contributors": [
        {%- for contributorId in allContributors -%}
          {%- assign contributor = site.data.authors.authors[contributorId] -%}
          {
            "id": {{ contributorId | jsonify }},
            "name": {{ contributor.name | jsonify }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "contributors_names": "{%- for contributorId in allContributors -%}{%- assign contributor = site.data.authors.authors[contributorId] -%}{{ contributor.name | replace: ' ', '&nbsp;' }}{%- unless forloop.last %}, {% endunless -%}{%- endfor -%}",
      "layout": {{ post.layout | jsonify }},
      "word_count": {{ post.content | number_of_words }},
      {%- assign readingSpeed = 275 -%}
      {%- assign minutes = post.content | number_of_words | divided_by: readingSpeed -%}
      "reading_time": "{%- if minutes == 0 -%}1 min read{%- else -%}{{ minutes }} min read{%- endif -%}",
      "excerpt"  : {{ post.excerpt | strip_html | truncatewords: 30 | jsonify }},
      "colour"   : "{%- include post_colour.html post=post -%}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]